# Cluster settings read by slurm/submit.sh, slurm/plan.sh and slurm/common.sh.
# Copy this file to slurm/cluster.env and set the values for your cluster; slurm/cluster.env is not tracked by git.
# Values set on the command line (e.g. PARTITION=gpu bash slurm/submit.sh stream) win over these.
PARTITION="${PARTITION:-gpu}"         # GPU partition
ACCOUNT="${ACCOUNT:-}"                # Slurm account; empty or "none" = your default account
GPU_TYPE="${GPU_TYPE:-}"              # e.g. h200 or a100; empty = any GPU
TIME_LIMIT="${TIME_LIMIT:-20:00:00}"
MEM="${MEM:-160G}"
CPUS="${CPUS:-16}"
LAB_DIR="${LAB_DIR:-$HOME}"           # where the Python environment and the Hugging Face cache live
CUDA_MODULE="${CUDA_MODULE-}"         # e.g. cuda/12.4; empty = no module is loaded
ENV_PATH="${ENV_PATH:-$LAB_DIR/envs/firegate}"   # a conda env or a venv
CONDA_SH="${CONDA_SH:-}"              # path to conda.sh, only needed when ENV_PATH is a conda env
HF_HOME="${HF_HOME:-$LAB_DIR/hf_cache}"
